# =============================================================
#  MAAL - Premium Video Streaming Platform
#  Environment configuration sample. Copy to `.env` and edit.
# =============================================================

# ----- Application -----
APP_NAME="Maal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Force HTTPS for all generated URLs (recommended in production)
FORCE_HTTPS=true

BCRYPT_ROUNDS=12

# ----- Logging -----
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ----- Database (MySQL 8) -----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=maal
DB_USERNAME=maal
DB_PASSWORD=

# ----- Session / Cache / Queue (Redis recommended) -----
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# ----- Redis -----
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE=default

# ----- Mail (SMTP) -----
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================
#  STORAGE / OBJECT STORAGE
#  Active disk used for private originals + HLS output.
#  Options: local | s3 | r2 | b2 | spaces
# =============================================================
FILESYSTEM_DISK=local
MEDIA_DISK=r2

# Public CDN domain that fronts the HLS/thumbnail bucket (no trailing slash)
CDN_URL=

# ----- Amazon S3 -----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_URL=
AWS_ENDPOINT=

# ----- Cloudflare R2 (S3-compatible) -----
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_URL=

# ----- Backblaze B2 (S3-compatible) -----
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_BUCKET=
B2_REGION=us-west-002
B2_ENDPOINT=https://s3.us-west-002.backblazeb2.com
B2_URL=

# ----- DigitalOcean Spaces (S3-compatible) -----
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
SPACES_BUCKET=
SPACES_REGION=nyc3
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_URL=

# =============================================================
#  STREAMING / TRANSCODING
# =============================================================
FFMPEG_BINARY=/usr/bin/ffmpeg
FFPROBE_BINARY=/usr/bin/ffprobe
FFMPEG_THREADS=0

# Signed HLS URL settings
HLS_SIGNING_KEY=
HLS_URL_TTL=14400

# Global default preview length (seconds) - overridable per category/video
DEFAULT_PREVIEW_SECONDS=20

# Upload limits / quotas
MAX_STORAGE_QUOTA_GB=0
UPLOAD_CHUNK_SIZE_MB=8
ALLOWED_VIDEO_FORMATS=mp4,mov,mkv,webm,avi

# Device / session control
DEFAULT_DEVICE_LIMIT=2

# Watermark defaults
WATERMARK_ENABLED=false
WATERMARK_OPACITY=0.35
WATERMARK_MOVE_INTERVAL=8

# =============================================================
#  PAYMENT GATEWAYS  (PayU is the primary gateway)
# =============================================================
DEFAULT_PAYMENT_GATEWAY=payu
APP_CURRENCY=INR

# ----- PayU (Primary) -----
PAYU_ENABLED=true
PAYU_MODE=production
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_AUTH_HEADER=

# ----- Razorpay -----
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ----- Stripe -----
STRIPE_ENABLED=false
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ----- Manual / Bank transfer approval -----
MANUAL_PAYMENT_ENABLED=true

# =============================================================
#  NOTIFICATIONS / INTEGRATIONS
# =============================================================
# WhatsApp click-to-chat / provider
WHATSAPP_ENABLED=true
WHATSAPP_NUMBER=
WHATSAPP_PROVIDER=link

# OTP (phone) provider
PHONE_OTP_ENABLED=false
SMS_PROVIDER=

VITE_APP_NAME="${APP_NAME}"
